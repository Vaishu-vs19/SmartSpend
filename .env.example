# ===================================================================
# SmartSpend — Environment Configuration Template
# ===================================================================
# Copy this file to .env or enter these values directly into the 
# SmartSpend in-app Project Connection drawer or Settings panel.
#
# IMPORTANT:
# - Use ONLY your public `anon` key.
# - NEVER put your Supabase `service_role` key or database password here!
# ===================================================================

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Public Anon Key (safe for frontend client usage)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key_only
